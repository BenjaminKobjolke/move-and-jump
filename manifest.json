{
  "manifest_version": 3,
  "name": "Move and Jump",
  "version": "0.1.4",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "author": "Daniel Kraus",
  "browser_specific_settings": {
    "gecko": {
      "id": "move-and-jump@bovender.de",
      "strict_min_version": "128.0"
    }
  },
  "permissions": ["accountsRead", "messagesRead", "messagesMove", "storage"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "move-search": {
      "suggested_key": { "default": "Ctrl+Shift+S" },
      "description": "__MSG_commandMoveSearchDescription__"
    },
    "move-last": {
      "suggested_key": { "default": "Ctrl+Alt+S" },
      "description": "__MSG_commandMoveLastDescription__"
    },
    "jump-search": {
      "suggested_key": { "default": "Ctrl+Shift+G" },
      "description": "__MSG_commandJumpSearchDescription__"
    },
    "jump-last": {
      "suggested_key": { "default": "Ctrl+Alt+G" },
      "description": "__MSG_commandJumpLastDescription__"
    }
  },
  "options_ui": {
    "page": "options/options.html"
  }
}
